// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider   = "prisma-client-js"
  engineType = "library" 
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  passwordHash  String
  createdAt     DateTime @default(now())

  fatura        Fatura[]
  enrollment    Enrollment[]
  classGroup    ClassGroup[]
  students      Student[]
  courses       Course[]
}

model Student {
  id               Int          @id @default(autoincrement())
  fullName         String       @map("nome")
  cpf              String       
  birthDate        DateTime     @map("data_nascimento")
  email            String       
  phone            String?      @map("telefone")
  enrollmentDate   DateTime     @default(now()) @map("data_matricula")
  enrollmentCount  Int          @default(0) @map("quantidadeMatriculas")
  userId           Int

  user             User         @relation(fields: [userId], references: [id])
  enrollments      Enrollment[] @relation("StudentEnrollments")
  faturas          Fatura[]     @relation("StudentInvoices")

  @@map("Aluno")
}

model Course {
  id           Int          @id @default(autoincrement())
  name         String       @map("nome")
  code         String       
  price        Decimal      @db.Decimal(10, 2) @map("valor")
  billingCycle String       @map("cobranca")
  userId       Int

  user         User         @relation(fields: [userId], references: [id])
  classGroups  ClassGroup[]
  enrollments  Enrollment[] @relation("CourseEnrollments")

  @@map("Curso")
}

model ClassGroup {
  id            Int          @id @default(autoincrement())
  courseId      Int          @map("cursoId")
  name          String       
  year          Int          @map("ano")
  number        Int          @map("numero")
  maxSeats      Int          @map("vagasMax")
  studentCount  Int          @map("qtdAlunos")
  nextEnrollmentNumber Int   @default(0) @map("proximoNumeroMatricula")
  availableSeats Int?        @map("vagasDisponiveis")
  status        String    

  userId       Int

  user          User         @relation(fields: [userId], references: [id])  
  course        Course       @relation(fields: [courseId], references: [id])
  enrollments   Enrollment[] @relation("ClassGroupEnrollments")

  @@map("Turma")
}

model Enrollment {
  id           Int        @id @default(autoincrement())
  studentId    Int        @map("alunoId")
  courseId     Int        @map("cursoId")
  classGroupId Int        @map("turmaId")
  name         String     
  status       String
  userId       Int

  user         User       @relation(fields: [userId], references: [id])
  student      Student    @relation("StudentEnrollments", fields: [studentId], references: [id])
  course       Course     @relation("CourseEnrollments", fields: [courseId], references: [id])
  classGroup   ClassGroup @relation("ClassGroupEnrollments", fields: [classGroupId], references: [id])
  faturas      Fatura[]   @relation("EnrollmentInvoices")

  @@map("Matricula")
}

model Fatura {
  id           Int        @id @default(autoincrement())
  studentId    Int        @map("alunoId")
  enrollmentId Int        @map("matriculaId")
  value        Decimal    @db.Decimal(10, 2) @map("valor")
  issueDate    DateTime   @default(now()) @map("dataEmissao")
  dueDate      DateTime   @map("dataVencimento")
  currency     String     @map("cobranca")
  status       String
  userId       Int

  user         User       @relation(fields: [userId], references: [id])
  student      Student    @relation("StudentInvoices", fields: [studentId], references: [id])
  enrollment   Enrollment @relation("EnrollmentInvoices", fields: [enrollmentId], references: [id])

  @@map("Fatura")
}
